#!/bin/sh
# Pre-push: run release-readiness gates.
set -e

echo "→ gofmt check..."
UNFMT=$(gofmt -l .)
if [ -n "$UNFMT" ]; then
  echo "ERROR: unformatted files:"
  echo "$UNFMT"
  exit 1
fi

echo "→ go build..."
go build ./...

echo "→ go vet..."
go vet ./...

echo "→ go test..."
go test ./...

if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  echo "→ npm check..."
  npm run check

  echo "→ npm smoke..."
  npm test

  echo "→ release contract..."
  npm run release:contract
else
  echo "ERROR: node/npm not available; cannot run release checks"
  exit 1
fi
